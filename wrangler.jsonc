{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "support-email-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "SEND",
      "allowed_destination_addresses": ["inovuslabs@kjcmt.ac.in"]
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SupportAgent"] },
    { "tag": "v2", "deleted_classes": ["SupportAgent"] }
  ],
  "vars": {
    "MAIL_FROM": "info@inovuslabs.org",
    "TEAM_INBOX": "inovuslabs@kjcmt.ac.in",
    "TURNSTILE_ENABLED": "false"
  }
}
